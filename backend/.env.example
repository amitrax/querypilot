# ==============================================================================
# QueryPilot - Environment Configuration
# ==============================================================================

# Database Configuration:
# 1. Zero-config local development / testing:
DATABASE_URL=sqlite:///./querypilot.db

# 2. Production Supabase PostgreSQL:
# - Supabase Transaction Pooler (PgBouncer port 6543 - recommended for serverless/high concurrency):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# - Supabase Session Pooler (port 5432):
#   DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# - Supabase Direct Connection (port 5432):
#   DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Alternatively:
# SUPABASE_DB_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Database Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_SSL_REQUIRE=false

# Security & Authentication
# Generate a secure key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev-secret-key-querypilot-production-standard-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration:
# Set STORAGE_BACKEND to 'local' for local filesystem, or 'supabase' for Supabase Private Storage Buckets
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# Supabase Storage Configuration (Required if STORAGE_BACKEND=supabase)
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[supabase-service-role-secret-key]
# SUPABASE_STORAGE_BUCKET=querypilot-data

# Optional AI Provider Configuration
# Supported providers: 'openai', 'gemini', 'anthropic', 'ollama', or 'heuristic' (default offline engine)
AI_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# CORS & Server Origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Frontend public API URL (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000
